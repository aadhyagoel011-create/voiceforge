{
  "name": "voiceforge",
  "version": "1.0.0",
  "description": "VoiceForge — Describe It. Talk to It. Deploy It. No-code voice AI agent builder.",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev": "node scripts/start.js",
    "dev:server": "npm --prefix server start",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node scripts/start.js"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.65.0"
  },
  "keywords": [
    "voice-ai",
    "elevenlabs",
    "conversational-ai",
    "agent-builder"
  ],
  "author": "VoiceForge Team",
  "license": "MIT"
}
